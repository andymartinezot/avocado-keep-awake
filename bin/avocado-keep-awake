#!/bin/zsh
# avocado-keep-awake: keep the Mac awake from herdr, in one of three modes.
#
#   on     keep the computer awake continuously
#   agent  stay awake while at least one herdr agent is working (default)
#   off    allow normal system sleep
#
# Awake means a `caffeinate -i` process: no idle system sleep, the display can
# still sleep. It is tied to the herdr server (-w) so it never outlives it.
#
# usage: avocado-keep-awake [panel|status [--short]|set on|agent|off|cycle|sync|help]

emulate -L zsh
setopt pipe_fail

PLUGIN_ID=andymartinezot.avocado-keep-awake
MODES=(on agent off)
typeset -A TITLE=(on On agent Agent off Off)
typeset -A HINT=(
  on    "Keep this computer awake continuously"
  agent "Stay awake while an agent is working"
  off   "Allow normal system sleep behavior"
)

herdr=${HERDR_BIN_PATH:-herdr}
# Called from herdr the dir is in the environment; from a shell or the tab bar, ask herdr.
dir=${HERDR_PLUGIN_CONFIG_DIR:-$("$herdr" plugin config-dir $PLUGIN_ID 2>/dev/null)}
[[ -n $dir ]] || dir=${XDG_CONFIG_HOME:-$HOME/.config}/herdr/plugins/config/$PLUGIN_ID
mkdir -p "$dir"
mode_file=$dir/mode
pid_file=$dir/caffeinate.pid
lock_dir=$dir/.lock

mode() {
  local m=$(cat "$mode_file" 2>/dev/null)
  (( ${MODES[(Ie)$m]} )) && print -r -- $m || print agent
}

awake_pid() {
  local pid=$(cat "$pid_file" 2>/dev/null)
  [[ $pid == <-> ]] && [[ $(ps -p $pid -o comm= 2>/dev/null) == *caffeinate ]] && print $pid
}

working_agents() {
  "$herdr" agent list 2>/dev/null | grep -o '"agent_status":"working"' | wc -l | tr -d ' '
}

herdr_server_pid() {
  ps -axo pid=,command= | awk '$2 ~ /(^|\/)herdr$/ && $3 == "server" && NF == 3 {print $1; exit}'
}

hold() {
  [[ -n $(awake_pid) ]] && return
  local server=$(herdr_server_pid)
  caffeinate -i ${server:+-w} ${server:+$server} </dev/null >/dev/null 2>&1 &!
  print $! >"$pid_file"
}

release() {
  local pid=$(awake_pid)
  [[ -n $pid ]] && kill $pid 2>/dev/null
  rm -f "$pid_file"
}

# Bring caffeinate in line with the mode. Events can fire in bursts, so one at a time.
sync() {
  local tries=0
  until mkdir "$lock_dir" 2>/dev/null; do
    (( ++tries > 50 )) && { rm -rf "$lock_dir"; continue; }   # stale lock
    sleep 0.05
  done
  {
    case $(mode) in
      on) hold ;;
      off) release ;;
      agent) (( $(working_agents) > 0 )) && hold || release ;;
    esac
  } always { rmdir "$lock_dir" 2>/dev/null }
}

state() { [[ -n $(awake_pid) ]] && print Active || print Inactive; }

status() {
  local m=$(mode)
  if [[ ${1:-} == --short ]]; then
    # For herdr's tab bar: nothing while sleep is allowed.
    [[ -n $(awake_pid) ]] && print "☕ ${TITLE[$m]}"
    return 0
  fi
  print "${TITLE[$m]} · $(state)"
  [[ $m == agent ]] && print "$(working_agents) agent(s) working"
  return 0
}

toast() {
  local m=$(mode)
  "$herdr" notification show "Keep awake: ${TITLE[$m]}" --body "${HINT[$m]} · $(state)" >/dev/null 2>&1
}

set_mode() {
  (( ${MODES[(Ie)${1:-}]} )) || { print -u2 "mode must be one of: ${MODES[*]}"; return 2; }
  print $1 >"$mode_file"
  sync
  [[ -n ${HERDR_ENV:-} ]] && toast
  return 0
}

cycle() {
  local i=${MODES[(Ie)$(mode)]}
  set_mode ${MODES[$(( i % ${#MODES} + 1 ))]}
}

# ---- theme --------------------------------------------------------------------
# The avocado palette, shared with avocado-trope (src/theme.rs there): same theme
# ids, same colors, same roles. Order per theme:
#   canvas surface muted subtle accent text success error warn
# A color is #rrggbb, iN (256-color index), aN (ANSI color N) or - (terminal default).
typeset -A THEMES=(
  dracula     '#21222c #282a36 #44475a #6272a4 #ff79c6 #f8f8f2 #50fa7b #ff5555 #f1fa8c'
  catppuccin  '#181825 #1e1e2e #45475a #7f849c #f5c2e7 #cdd6f4 #a6e3a1 #f38ba8 #f9e2af'
  tokyo-night '#16161e #1a1b26 #3b4261 #565f89 #e0af68 #c0caf5 #9ece6a #f7768e #e0af68'
  gruvbox     '#1d2021 #282828 #504945 #928374 #fabd2f #ebdbb2 #b8bb26 #fb4934 #fabd2f'
  nord        '#242933 #2e3440 #434c5e #616e88 #ebcb8b #eceff4 #a3be8c #bf616a #ebcb8b'
  classic     'i233 i234 i237 i240 i178 i231 i71 i167 i214'
  terminal    '- - a8 a8 a4 - a2 a1 a3'
)
ROLES=(canvas surface muted subtle accent text success error warn)

# Map a theme name to an id above, the way avocado-trope does: herdr's
# tokyo-night-storm, catppuccin-mocha, gruvbox-dark… work, light variants use terminal.
theme_id() {
  local n=${${1:l}//[_ ]/-}
  if [[ -n ${(M)${(s:-:)n}:#(latte|day|light|dawn)} ]]; then n=terminal
  elif [[ $n == tokyo* ]]; then n=tokyo-night
  elif [[ $n == catppuccin* ]]; then n=catppuccin
  elif [[ $n == gruvbox* ]]; then n=gruvbox
  elif [[ $n == (zoetrope|default) ]]; then n=classic
  fi
  [[ -n ${THEMES[$n]-} ]] && print -r -- $n
}

# First match wins: $AVOCADO_KEEP_AWAKE_THEME or $AVOCADO_THEME, the theme last
# picked in avocado-trope, herdr's [theme] name, then dracula.
pick_theme() {
  local name id conf=${HERDR_CONFIG_PATH:-${XDG_CONFIG_HOME:-$HOME/.config}/herdr/config.toml}
  for name in "${AVOCADO_KEEP_AWAKE_THEME-}" "${AVOCADO_THEME-}" \
      "$(head -n1 "${XDG_CONFIG_HOME:-$HOME/.config}/avocado-trope/theme" 2>/dev/null)" \
      "$(awk '/^\[/{t=($0=="[theme]");next} t && /^[ \t]*name[ \t]*=/{sub(/^[^=]*=[ \t]*/,"");sub(/[ \t]*#.*/,"");gsub(/["'\'']/,"");print;exit}' "$conf" 2>/dev/null)"; do
    [[ -n $name ]] && id=$(theme_id $name) && [[ -n $id ]] && { print $id; return; }
  done
  print dracula
}

# SGR for one color: sgr fg|bg COLOR
sgr() {
  local base=$([[ $1 == fg ]] && print 3 || print 4) c=$2
  case $c in
    '#'*) print -n "${base}8;2;$((16#${c[2,3]}));$((16#${c[4,5]}));$((16#${c[6,7]}))" ;;
    i*)   print -n "${base}8;5;${c#i}" ;;
    a*)   (( ${c#a} < 8 )) && print -n "${base}${c#a}" || print -n "$(( base == 3 ? 9 : 10 ))$(( ${c#a} - 8 ))" ;;
    *)    print -n "${base}9" ;;
  esac
}

# ---- panel --------------------------------------------------------------------

panel() {
  sync   # so the header is right even if an event was missed
  local esc=$'\e' current=$(mode) key rest width=${COLUMNS:-50}
  local cursor=${MODES[(Ie)$current]} theme=$(pick_theme) i
  (( width > 60 )) && width=60
  local -A C   # role → foreground SGR on the surface background
  local -a col=(${=THEMES[$theme]})
  for i in {1..${#ROLES}}; do C[${ROLES[$i]}]=${col[$i]}; done
  local BG="${esc}[0;$(sgr bg ${C[surface]})m"
  st() { print -rn -- "${BG}${esc}[$(sgr fg ${C[$1]})${2:+;$2}m"; }   # st ROLE [1=bold]
  local TXT=$(st text) DIM=$(st subtle) RULE=$(st muted) KEY=$(st accent 1) BOLD=$(st text 1)
  local OK=$(st success 1) PILL="${esc}[0;$(sgr bg ${C[accent]});$(sgr fg ${C[canvas]});1m"
  local SEL="${esc}[0;$(sgr bg ${C[muted]});$(sgr fg ${C[accent]});1m" K="${esc}[K"
  [[ $theme == terminal ]] && SEL="${esc}[0;7;1m"   # ANSI blue on gray is hard to read
  trap 'print -n "${esc}[0m${esc}[2J${esc}[?25h${esc}[?1049l"; stty echo 2>/dev/null' EXIT
  print -n "${esc}[?1049h${esc}[?25l${BG}${esc}[2J"
  stty -echo 2>/dev/null

  pad() { print -rn -- "${(l:$1:: :)}"; }

  draw() {
    local m=$(mode) mark name out pill=" avocado-keep-awake " live=$(state) id
    local right="${TITLE[$m]} · $live"
    local livec=$([[ $live == Active ]] && print -rn -- "$OK" || print -rn -- "$DIM")
    # Build the frame first and write it in one go over the old one: no flicker.
    out="${esc}[H${BG}$K"$'\n'
    out+="${BG} ${PILL}${pill}${TXT}$(pad $((width - 2 - ${#pill} - ${#right})))${BOLD}${TITLE[$m]}${DIM} · ${livec}${live}${BG}$K"$'\n'
    out+="${BG}$K"$'\n'
    out+="${BG} ${BOLD}Keep computer awake$K"$'\n'
    out+="${BG} ${RULE}${(l:$((width - 2))::─:)}${BG}$K"$'\n'
    for i in 1 2 3; do
      id=${MODES[$i]}
      [[ $id == $m ]] && mark="${OK}●" || mark="${TXT} "
      if (( i == cursor )); then
        name="${SEL}▸ ${TITLE[$id]}$(pad $((width - 7 - ${#TITLE[$id]})))${BG}"
      else
        name="${BOLD}  ${TITLE[$id]}"
      fi
      out+="${BG} ${mark}${BG} ${name}$K"$'\n'"${BG}     ${DIM}${HINT[$id]}$K"$'\n'"${BG}$K"$'\n'
    done
    out+="${BG} ${KEY}↑↓${DIM} move  ${KEY}⏎${DIM} select  ${KEY}1-3${DIM} pick  ${KEY}esc${DIM} close$K${BG}${esc}[J"
    print -rn -- "$out"
  }

  draw
  while :; do
    key=
    if ! read -s -k 1 -t 1 key; then draw; continue; fi   # refresh the status line
    case $key in
      $esc)
        rest=
        read -s -k 2 -t 0.05 rest || { [[ -z $rest ]] && return 0; }
        case $rest in
          '[A'|'OA') (( cursor > 1 )) && (( cursor-- )) ;;
          '[B'|'OB') (( cursor < 3 )) && (( cursor++ )) ;;
        esac ;;
      k) (( cursor > 1 )) && (( cursor-- )) ;;
      j) (( cursor < 3 )) && (( cursor++ )) ;;
      [123]) cursor=$key; set_mode ${MODES[$cursor]}; return 0 ;;
      $'\n'|$'\r'|' ') set_mode ${MODES[$cursor]}; return 0 ;;
      q) return 0 ;;
    esac
    draw
  done
}

case ${1:-panel} in
  panel) panel ;;
  status) status ${2:-} ;;
  set) set_mode ${2:-} ;;
  on|agent|off) set_mode $1 ;;
  cycle) cycle ;;
  sync) sync ;;
  theme) pick_theme ;;
  help|-h|--help) sed -n '2,13s/^# \{0,1\}//p' $0 ;;
  *) print -u2 "unknown command: $1 (try help)"; exit 2 ;;
esac
